---
import PageLayout from '../layouts/PageLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Sankalp',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web, iOS, Android',
  url: 'https://sankalphealth.in/app.html',
  description: 'An Ayurvedic health app that builds a personalized daily plan of yoga, meditation, breathwork and diet from your dosha (Prakriti), backed by modern neuroscience.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  publisher: { '@type': 'Organization', name: 'Sankalp', url: 'https://sankalphealth.in' },
};
---
<PageLayout
  title="Ayurveda Health App — Yoga, Meditation &amp; Diet by Dosha | Sankalp"
  description="An Ayurvedic health app: a personalized daily plan of yoga, meditation, breathwork and diet built from your dosha (Prakriti), backed by modern neuroscience. Free on the web; iOS & Android coming soon."
  path="/app.html"
  active="app"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

<!-- ========================
     HERO
======================== -->
<section class="hero" id="hero">
  <div class="hero-fx" aria-hidden="true"></div>
  <div class="hero-inner">

    <!-- LEFT: TEXT -->
    <div class="hero-text fade-in">
      <span class="eyebrow">Your body has been talking to you</span>
      <h1 class="hero-headline">Your practice.<br>Personalized<br>to your nature.</h1>
      <p class="hero-subcopy">Not another wellness app. Sankalp reads your body&rsquo;s design &mdash; your Prakriti &mdash; and writes a living daily practice for you, not everyone.</p>
      <div class="cta-group">
        <a href="https://app.sankalphealth.in/" target="_blank" rel="noopener" class="btn btn-primary">Open the App &rarr;</a>
      </div>
    </div>

    <!-- RIGHT: PHONE + BADGES -->
