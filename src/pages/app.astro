                <div class="ph-step active" id="ph-step-0">
                  <div class="ph-step-dot"><div class="ph-step-pulse"></div></div>
                  <span class="ph-step-text">Reading your nervous system signals&hellip;</span>
                </div>
                <div class="ph-step" id="ph-step-1">
                  <div class="ph-step-dot"></div>
                  <span class="ph-step-text">Mapping your Prakriti&hellip;</span>
