            <div class="phone-status">
              <span class="phone-status-time">9:41</span>
              <div class="phone-status-dots"><span></span><span></span><span></span></div>
            </div>
            <div style="padding:32px 14px 56px;flex:1;display:flex;flex-direction:column;overflow:hidden;">
