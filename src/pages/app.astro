  .timeline-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px #fff; margin: 10px auto; position: relative; z-index: 1; }
  .timeline-name { font-family: 'Fraunces', serif; font-size: 13px; letter-spacing: .3px; color: var(--ink); font-weight: 600; display: block; margin-bottom: 8px; }
