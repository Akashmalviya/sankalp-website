</style>

<script>
  // Fade-in on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

  // Animate dosha bars when the diagnosis card scrolls into view
  const doshaObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.ph-bar-fill').forEach(bar => {
          bar.style.width = bar.dataset.w + '%';
        });
        doshaObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.4 });
  document.querySelectorAll('.ph-prakriti').forEach(el => doshaObs.observe(el));

  // Hero phone: 2-stage animated sequence (Analysing → Home → loop)
  (function() {
    const stages = document.querySelectorAll('.phone-stage');
    const stepEls = document.querySelectorAll('.ph-step');
    if (stages.length < 2 || stepEls.length < 4) return;

    let stepTimer = null;
    let stageTimer = null;

    function resetSteps() {
      stepEls.forEach(el => {
        el.classList.remove('active', 'done');
        const dot = el.querySelector('.ph-step-dot');
        if (dot) dot.innerHTML = '';
      });
      activateStep(0);
    }

    function activateStep(i) {
      const el = stepEls[i];
      if (!el) return;
      el.classList.add('active');
      const dot = el.querySelector('.ph-step-dot');
      if (dot) dot.innerHTML = '<div class="ph-step-pulse"></div>';
    }

    function completeStep(i) {
      const el = stepEls[i];
      if (!el) return;
      el.classList.remove('active');
      el.classList.add('done');
      const dot = el.querySelector('.ph-step-dot');
      if (dot) dot.innerHTML = '&#10003;';
    }

    function showStage(index) {
      stages.forEach((s, i) => s.classList.toggle('active', i === index));
    }

    function runStage1() {
      clearTimeout(stageTimer);
      clearInterval(stepTimer);
      resetSteps();
      showStage(0);
      let s = 0;
      stepTimer = setInterval(function() {
        completeStep(s);
        s++;
        if (s < stepEls.length) {
          activateStep(s);
        } else {
          clearInterval(stepTimer);
        }
      }, 1400);
      stageTimer = setTimeout(runStage2, 7200);
    }

    function runStage2() {
      clearInterval(stepTimer);
      showStage(1);
      stageTimer = setTimeout(runStage1, 8500);
    }

    resetSteps();
    showStage(0);
    stageTimer = setTimeout(function() {
      let s = 0;
      stepTimer = setInterval(function() {
        completeStep(s);
        s++;
        if (s < stepEls.length) activateStep(s);
        else clearInterval(stepTimer);
      }, 1400);
      setTimeout(runStage2, 7200);
    }, 600);
  })();
</script>
