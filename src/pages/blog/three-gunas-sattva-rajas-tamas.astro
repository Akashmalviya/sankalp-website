<style>
  /* Local semantic tones for the three Gunas — Sattva (clarity) uses the
     brand gold, Rajas (activity/passion) uses the brand accent orange,
     Tamas (inertia) uses a desaturated slate distinct from --muted text. */
  .guna-sattva { --guna: var(--gold); --guna-soft: var(--gold-soft); }
  .guna-rajas { --guna: var(--accent); --guna-soft: var(--accent-soft); }
  .guna-tamas { --guna: #7b8496; --guna-soft: var(--bg-soft); }

  /* VERSE BLOCKS */
  .verse {
    margin: 30px 0;
    padding: 26px 28px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
  }
  .verse .devanagari {
    font-family: 'Noto Sans Devanagari', serif;
    font-size: 17px;
    color: var(--gold);
    line-height: 1.8;
    margin-bottom: 12px;
    display: block;
  }
  .verse .translation { font-size: 15px; font-style: italic; color: var(--muted); line-height: 1.7; margin-bottom: 0; }
  .verse .ref { font-family: 'Fraunces', serif; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin-top: 10px; display: block; }

  /* GUNA SECTIONS */
  .guna-section {
    margin: 40px 0;
    padding: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    border-top: 3px solid var(--guna);
    background: var(--guna-soft);
  }

  .guna-header { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
  .guna-icon {
    width: 50px; height: 50px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    border: 1px solid var(--guna);
    color: var(--guna);
    background: var(--bg-card);
  }
  .guna-header h3 { margin: 0; font-family: 'Fraunces', serif; font-size: 22px; color: var(--guna); }
  .guna-subtitle { font-size: 13px; font-style: italic; color: var(--muted); margin-top: 2px; }

  .guna-body p { font-size: 16px; margin-bottom: 14px; }

  .influence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 16px 0; }
  .influence-block { padding: 16px; background: var(--bg-card); border: 1px solid var(--line); border-radius: 10px; }
  .influence-block h5 { font-family: 'Fraunces', serif; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ink); margin-bottom: 8px; font-weight: 600; }
  .influence-list { list-style: none; }
  .influence-list li { font-size: 14px; color: var(--text); padding: 3px 0 3px 16px; position: relative; line-height: 1.5; }
  .influence-list li::before { content: '—'; position: absolute; left: 0; color: var(--muted); }

  .guna-verse { margin: 16px 0; padding: 14px 18px; border-left: 3px solid var(--guna); background: var(--bg-card); border-radius: 0 10px 10px 0; }
  .guna-verse .devanagari { font-family: 'Noto Sans Devanagari', serif; font-size: 14px; color: var(--gold); line-height: 1.7; display: block; margin-bottom: 6px; }
  .guna-verse .meaning { font-size: 14px; font-style: italic; color: var(--muted); }
  .guna-verse .ref { font-family: 'Fraunces', serif; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin-top: 6px; display: block; }

  /* COMPARISON TABLE */
  .guna-compare { margin: 30px 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .compare-row { display: grid; grid-template-columns: 110px 1fr 1fr 1fr; border-bottom: 1px solid var(--line); }
  .compare-row:last-child { border-bottom: none; }
  .compare-header { background: var(--bg-soft); }
  .compare-cell { padding: 12px 14px; font-size: 13px; color: var(--text); line-height: 1.5; border-right: 1px solid var(--line); }
  .compare-cell:last-child { border-right: none; }
  .compare-header .compare-cell { font-family: 'Fraunces', serif; font-size: 12px; letter-spacing: 1px; color: var(--ink); font-weight: 600; }
  .compare-cell.label { font-family: 'Fraunces', serif; font-size: 11px; letter-spacing: 0.5px; color: var(--muted); background: var(--bg-soft); font-weight: 600; }

  @media (max-width: 768px) {
    .influence-grid { grid-template-columns: 1fr; }
    .compare-row { grid-template-columns: 76px 1fr 1fr 1fr; }
    .compare-cell { padding: 8px; font-size: 11px; }
  }
</style>
