  .dosha-kapha .dosha-icon{color:var(--earth);border-color:var(--earth)}

  .dosha-header h3{margin:0;font-family:'Fraunces',serif;font-size:20px;font-weight:600}
  .dosha-vata .dosha-header h3{color:var(--air)}
