  .checker-dosha h4{font-family:'Fraunces',serif;font-size:15px;letter-spacing:.5px;margin-bottom:4px;font-weight:600}
  .vata-check h4{color:var(--air)}
  .pitta-check h4{color:var(--fire)}
  .kapha-check h4{color:var(--earth)}

  .checker-dosha .elements-label{font-size:12px;font-style:italic;color:var(--muted);margin-bottom:14px;display:block}

