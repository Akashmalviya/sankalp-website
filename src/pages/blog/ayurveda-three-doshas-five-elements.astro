  .sign-col h5{font-family:'Fraunces',serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;font-weight:600}
  .sign-col ul{list-style:none}
  .sign-col li{font-size:14px;color:var(--muted);padding:3px 0 3px 16px;position:relative;line-height:1.5}
  .sign-col li::before{content:'›';position:absolute;left:0;font-size:13px;color:var(--gold);top:2px}

  .remedy-box{margin-top:14px;padding:14px 18px;border-radius:10px;background:var(--gold-soft);border:1px solid var(--line)}
  .remedy-box h5{font-family:'Fraunces',serif;font-size:11px;letter-spacing:1.5px;color:var(--gold);margin-bottom:6px;font-weight:600}
  .remedy-box p{font-size:14px;color:var(--text);margin-bottom:0;line-height:1.6}

  /* MOBILE */
  @media (max-width: 768px) {
    .elements-grid { grid-template-columns: repeat(3, 1fr); }
    .dosha-traits { grid-template-columns: 1fr; }
    .sign-columns { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .elements-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
