  .element-card .symbol{font-size:28px;margin-bottom:8px;display:block;color:var(--gold)}
  .element-card .sanskrit{font-family:'Noto Sans Devanagari',serif;font-size:12px;color:var(--gold);font-weight:500;display:block;margin-bottom:2px}
  .element-card h4{font-family:'Fraunces',serif;color:var(--ink);font-size:11px;letter-spacing:1.5px;margin-bottom:6px;font-weight:600}
  .element-card p{font-size:12px;color:var(--muted);line-height:1.4;margin-bottom:0}
  .element-space{border-top:3px solid var(--gold)}
  .element-air{border-top:3px solid var(--air)}
  .element-fire{border-top:3px solid var(--fire)}
  .element-water{border-top:3px solid var(--air)}
  .element-earth{border-top:3px solid var(--earth)}

  /* DOSHA CARDS */
