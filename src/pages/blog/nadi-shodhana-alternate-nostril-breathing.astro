    { '@type': 'HowToStep', position: 3, name: 'Inhale through the left nostril', text: 'Close the right nostril with your thumb. Inhale slowly and smoothly through the left nostril.' },
    { '@type': 'HowToStep', position: 4, name: 'Exhale through the right nostril', text: 'Close the left nostril with your ring finger and release the thumb. Exhale slowly through the right nostril.' },
