  @media (max-width: 380px) {
    .cx-track-grid { grid-template-columns: 1fr; }
    .cx-week-day { flex-basis: 72%; }
    .cx-story-legend span:nth-child(n+3) { display: none; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealables = document.querySelectorAll('.reveal, [data-journey], [data-timeline], [data-week]');
  if (reduced || !('IntersectionObserver' in window)) {
    revealables.forEach((el) => el.classList.add('in'));
    document.querySelectorAll('[data-journey-end]').forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          if (e.target.hasAttribute('data-journey')) {
            e.target.closest('.cx-bridge')?.querySelector('[data-journey-end]')?.classList.add('in');
          }
          io.unobserve(e.target);
        });
      },
      { threshold: 0.18, rootMargin: '0px 0px -40px 0px' }
    );
    revealables.forEach((el) => io.observe(el));
  }

  const triggers = document.querySelectorAll('.cx-pillar-trigger');
  const panels = document.querySelectorAll('.cx-pillar-body');
  const items = document.querySelectorAll('.cx-pillar-item');
  triggers.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-pillar');
      triggers.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        const on = panel.getAttribute('data-panel') === id;
        panel.classList.toggle('active', on);
        panel.hidden = !on;
      });
      items.forEach((item) => {
        item.classList.toggle('open', item.getAttribute('data-pillar-item') === id);
      });
    });
  });

  (() => {
    const grid = document.querySelector('[data-track-grid]');
    if (!grid) return;
    const cards = [...grid.querySelectorAll('.cx-track-card')];
    const canHover = () => window.matchMedia('(hover: hover)').matches;

    const clear = () => {
      grid.classList.remove('is-focusing');
      cards.forEach((c) => {
        c.classList.remove('is-open');
        c.querySelector('.cx-track-toggle')?.setAttribute('aria-expanded', 'false');
      });
    };

    const activate = (card) => {
      cards.forEach((c) => {
        const on = c === card;
        c.classList.toggle('is-open', on);
        c.querySelector('.cx-track-toggle')?.setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      grid.classList.add('is-focusing');
    };

    cards.forEach((card) => {
      const btn = card.querySelector('.cx-track-toggle');
      if (!btn) return;

      btn.addEventListener('click', () => {
        if (card.classList.contains('is-open') && grid.classList.contains('is-focusing')) {
          clear();
        } else {
          activate(card);
        }
      });

      card.addEventListener('mouseenter', () => {
        if (canHover()) activate(card);
      });
    });

    grid.addEventListener('mouseleave', () => {
      if (canHover()) clear();
    });
  })();

  document.querySelectorAll('[data-cta]').forEach((el) => {
    el.addEventListener('click', () => {
      if (typeof gtag === 'function') {
        gtag('event', 'cta_click', { location: el.dataset.cta });
      }
    });
  });
</script>
