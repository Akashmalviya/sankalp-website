    .cx-pillar-mini p,
    .cx-pillar-mini li { font-size: 13.5px; }

    .cx-doctor { padding-top: 48px; padding-bottom: 48px; }
    .cx-doctor-split { margin-top: 28px; gap: 12px; }
    .cx-consult { padding: 18px 16px 20px; border-radius: 16px; }
    .cx-chat p { padding: 12px 14px; font-size: 14px; border-radius: 12px; }

    .cx-privacy-panel { padding: 28px 18px; border-radius: 18px; }
    .cx-privacy-points { gap: 8px; }
    .cx-privacy-points li { font-size: 13px; padding: 7px 12px; }

    .cx-trust { padding-top: 28px; padding-bottom: 48px; }
    .cx-trust-roles { margin-top: 24px; gap: 8px; }
    .cx-trust-roles li { padding: 8px 12px; font-size: 13px; }
