---
import PageLayout from '../layouts/PageLayout.astro';

const appHref = 'https://app.sankalphealth.in/';
const waHref = 'https://chat.whatsapp.com/KrM12p1vtUXF1ZQkssvBF3';

const trackItems = [
  {
    id: 'meals',
    label: 'Meals',
    promise: 'We remember what you eat.',
    logs: ['Quick photo', 'Meal timing', 'Cravings'],
    entryTitle: 'Lunch · 1:10 PM',
    entryDetail: 'Dal, rice, and salad',
    pattern: 'Heavy lunches → afternoon sleepiness',
    frequency: 'Appears 4× this week',
  },
  {
    id: 'sleep',
    label: 'Sleep',
    promise: 'We notice how you recover.',
    logs: ['Bedtime', 'Wake time', 'Energy'],
    entryTitle: 'Night sleep · 11:42 PM',
    entryDetail: 'Fell asleep late after dinner',
    pattern: 'Later dinners → later sleep → lower morning energy',
    frequency: 'Three nights this week',
  },
  {
    id: 'movement',
    label: 'Movement',
    promise: 'Small walks still count.',
    logs: ['Walks', 'Exercise', 'Sitting breaks'],
    entryTitle: '20 min walk · 7:05 PM',
    entryDetail: 'After dinner around the block',
    pattern: 'Walking after dinner improves sleep quality',
    frequency: 'Stronger on walking days',
  },
  {
    id: 'stress',
    label: 'Stress',
    promise: 'The load you carry shows up.',
    logs: ['Mood', 'Tension', 'Notes'],
    entryTitle: 'Work stress · 7/10',
    entryDetail: 'Logged mid-afternoon',
    pattern: 'Stress spikes every Monday afternoon',
    frequency: 'Seen across 3 Mondays',
  },
  {
    id: 'symptoms',
    label: 'Symptoms',
    promise: 'Body signals, remembered.',
    logs: ['Headache', 'Fatigue', 'Digestion'],
    entryTitle: 'Headache · 9:20 AM',
    entryDetail: 'Mild, after a short night',
    pattern: 'Usually appears after poor sleep',
    frequency: '4 of 5 times this month',
  },
  {
    id: 'medication',
    label: 'Medication',
    promise: 'Timing stays with the story.',
    logs: ['Dose', 'Time taken', 'Missed'],
    entryTitle: 'Evening dose · 9:00 PM',
    entryDetail: 'Taken on time',
    pattern: 'Timing stayed steady across the week',
    frequency: 'Useful context for your doctor',
  },
  {
    id: 'photos',
    label: 'Photos',
    promise: 'A plate says more than memory.',
    logs: ['Meals', 'Labels', 'Portions'],
    entryTitle: 'Dinner plate · 10:45 PM',
    entryDetail: 'Photo logged late',
    pattern: 'Late plates lined up with later sleep',
    frequency: 'Four late dinners this week',
  },
  {
    id: 'voice',
    label: 'Voice notes',
    promise: 'Say how you feel in seconds.',
    logs: ['Feelings', 'Energy', 'Context'],
    entryTitle: 'How I felt today · 18 sec',
    entryDetail: 'Low energy after lunch',
    pattern: 'Low-energy notes rose mid-week',
    frequency: 'Clustered Wed–Thu',
  },
];

const pillars = [
  {
    id: 'nutrition',
    label: 'Nutrition',
    why: 'What and when you eat shapes energy, digestion, and how the rest of your day feels.',
    signs: ['Afternoon crashes', 'Late dinners most nights', 'Heavy or foggy after meals'],
    notices: 'Meal timing drifts, skipped breakfasts, and how food lines up with sleep and stress.',
  },
  {
    id: 'sleep',
    label: 'Sleep',
    why: 'Rest is where recovery starts. A few late nights quietly change appetite, mood, and energy.',
    signs: ['Tired after a full night', 'Hard to fall asleep', 'Wired at midnight'],
    notices: 'Later bedtimes after late meals, and mornings that follow restless nights.',
  },
  {
    id: 'movement',
    label: 'Movement',
    why: 'Small movement across the day matters as much as a single workout.',
    signs: ['Long sitting stretches', 'Walks that disappear mid-week', 'Low energy after desk days'],
    notices: 'Consistency across the week, and how activity relates to stress and sleep.',
  },
  {
    id: 'stress',
    label: 'Stress',
    why: 'A body under constant load sleeps worse, digests poorly, and stays on edge.',
    signs: ['Mind won’t switch off', 'Irritability that isn’t you', 'Tension you stopped noticing'],
    notices: 'Stress spikes next to meals, sleep quality, and symptom days.',
  },
  {
    id: 'recovery',
    label: 'Recovery',
    why: 'Health isn’t only what you push. It’s also how you come back down.',
    signs: ['No real downtime', 'Weekends that don’t restore you', 'Always catching up'],
    notices: 'Whether rest days actually restore energy, sleep, and steadiness.',
  },
];

const timelineEvents = [
  { label: 'Meal', day: 2 },
  { label: 'Stress', day: 5 },
  { label: 'Late sleep', day: 8 },
  { label: 'Walk', day: 11 },
  { label: 'Skipped breakfast', day: 14 },
  { label: 'Anxiety', day: 17 },
  { label: 'Headache', day: 20 },
];
---
<PageLayout
  title="Sankalp · Understand your health beyond symptoms"
  description="Your health is shaped by what happens every day, not just during doctor visits. Sankalp helps you understand meals, sleep, movement, and stress, and share clearer context with professionals you trust."
  path="/"
  active="home"
>

<!-- ═══ TOP BAND: hero + bridge share one field ═══ -->
<div class="cx-topband">
  <div class="cx-hero-field" aria-hidden="true">
    <span class="cx-orb cx-orb-a"></span>
    <span class="cx-orb cx-orb-b"></span>
    <span class="cx-orb cx-orb-c"></span>
  </div>

<!-- ═══ HERO ═══ -->
<section class="cx-hero" id="top">
  <div class="cx-hero-grid wrap">
    <div class="cx-hero-copy">
      <p class="cx-kicker">Between appointments</p>
      <h1>Understand your<br />health beyond<br />symptoms.</h1>
      <p class="cx-lede">
        Daily habits become health insights you and your doctor can understand.
      </p>
      <div class="cx-cta">
        <a href={appHref} target="_blank" rel="noopener" class="btn btn-primary" data-cta="hero-start">Start free</a>
        <a href="#story" class="cx-link">See how it works →</a>
      </div>
    </div>

    <aside class="cx-hero-viz" aria-label="Animated preview of a Sankalp weekly health story">
      <div class="cx-story" aria-hidden="true">
        <div class="cx-story-top">
          <div>
            <p class="cx-story-kicker">Your week</p>
            <p class="cx-story-title">Health story</p>
          </div>
          <p class="cx-story-range">24–30 Mar</p>
        </div>

        <ol class="cx-story-days">
          <li class="cx-story-day" style="--d:0">
            <span class="cx-story-dow">Mon</span>
            <span class="cx-mark meal" title="Meal"></span>
            <span class="cx-mark sleep" title="Sleep"></span>
            <span class="cx-mark move" title="Move"></span>
          </li>
          <li class="cx-story-day" style="--d:1">
            <span class="cx-story-dow">Tue</span>
            <span class="cx-mark meal late" title="Late dinner"></span>
            <span class="cx-mark sleep" title="Sleep"></span>
            <span class="cx-mark stress" title="Stress"></span>
          </li>
          <li class="cx-story-day" style="--d:2">
            <span class="cx-story-dow">Wed</span>
            <span class="cx-mark meal late" title="Late dinner"></span>
            <span class="cx-mark sleep late" title="Later sleep"></span>
            <span class="cx-mark move" title="Move"></span>
          </li>
          <li class="cx-story-day" style="--d:3">
            <span class="cx-story-dow">Thu</span>
            <span class="cx-mark meal late" title="Late dinner"></span>
            <span class="cx-mark sleep late" title="Later sleep"></span>
            <span class="cx-mark stress hot" title="Higher stress"></span>
          </li>
          <li class="cx-story-day" style="--d:4">
            <span class="cx-story-dow">Fri</span>
            <span class="cx-mark meal" title="Meal"></span>
            <span class="cx-mark sleep late" title="Later sleep"></span>
            <span class="cx-mark move" title="Move"></span>
          </li>
          <li class="cx-story-day" style="--d:5">
            <span class="cx-story-dow">Sat</span>
            <span class="cx-mark meal" title="Meal"></span>
            <span class="cx-mark sleep" title="Sleep"></span>
            <span class="cx-mark move" title="Move"></span>
          </li>
          <li class="cx-story-day" style="--d:6">
            <span class="cx-story-dow">Sun</span>
            <span class="cx-mark meal" title="Meal"></span>
            <span class="cx-mark sleep" title="Sleep"></span>
            <span class="cx-mark stress" title="Stress"></span>
          </li>
        </ol>

        <div class="cx-story-legend">
          <span><i class="meal"></i> Meals</span>
          <span><i class="sleep"></i> Sleep</span>
          <span><i class="move"></i> Move</span>
          <span><i class="stress"></i> Stress</span>
        </div>

        <div class="cx-story-insight">
          <p class="cx-story-insight-label">Pattern noticed</p>
          <p class="cx-story-insight-text">Your evening routine has shifted this week. Late dinners were followed by later sleep and lower morning energy.</p>
        </div>

        <div class="cx-story-chip">
          <span class="cx-story-chip-dot"></span>
          Ready to share with your doctor
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- ═══ HEALTH STORY BRIDGE ═══ -->
<section class="cx-section cx-bridge" id="story">
  <div class="wrap cx-center">
    <p class="cx-kicker">What makes Sankalp different</p>
    <h2>Every day adds to your health story.</h2>
  </div>

  <div class="cx-cycle wrap" data-journey aria-label="You, Sankalp, and your doctor in a continuous loop">
    <div class="cx-cycle-row">
      <div class="cx-cycle-node" style="--i:0">
        <span class="cx-capsule">You</span>
      </div>
      <div class="cx-cycle-arrow" aria-hidden="true" style="--i:1">
        <span></span>
      </div>
      <div class="cx-cycle-node cx-cycle-node-core" style="--i:2">
        <span class="cx-capsule cx-capsule-core">Sankalp</span>
      </div>
      <div class="cx-cycle-arrow" aria-hidden="true" style="--i:3">
        <span></span>
      </div>
      <div class="cx-cycle-node" style="--i:4">
        <span class="cx-capsule">Doctor</span>
      </div>
    </div>
    <div class="cx-cycle-return" aria-hidden="true">
      <svg class="cx-cycle-return-svg" viewBox="0 0 520 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          class="cx-cycle-return-path"
          d="M470 4 V22 Q470 36 456 36 H64 Q50 36 50 22 V4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          class="cx-cycle-return-head"
          d="M44 12 L50 4 L56 12"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span class="cx-cycle-return-label">care returns to you</span>
    </div>

    <div class="cx-cycle-detail">
      <div class="cx-cycle-panel" style="--i:0">
        <p class="cx-journey-label">You</p>
        <p class="cx-journey-sub">Daily life</p>
        <ul class="cx-journey-chips">
          <li>Meals</li>
          <li>Sleep</li>
          <li>Stress</li>
          <li>Move</li>
        </ul>
      </div>
      <div class="cx-cycle-panel cx-cycle-panel-core" style="--i:1">
        <p class="cx-journey-label">Sankalp</p>
        <p class="cx-journey-sub">Turns days into a story</p>
        <ul class="cx-journey-actions">
          <li><strong>Organizes</strong> what you log</li>
          <li><strong>Finds</strong> patterns over time</li>
          <li><strong>Prepares</strong> context to share</li>
        </ul>
      </div>
      <div class="cx-cycle-panel" style="--i:2">
        <p class="cx-journey-label">Your doctor</p>
        <p class="cx-journey-sub">Sees the bigger picture</p>
        <blockquote class="cx-journey-quote">
          “Now I understand what’s actually happening between visits.”
        </blockquote>
      </div>
    </div>
  </div>

  <p class="cx-bridge-end wrap" data-journey-end>
    The relationship stays yours. Sankalp organizes the story.
  </p>
</section>
</div>

<!-- ═══ MID BAND: track → timeline → week share one field ═══ -->
<div class="cx-midband">

<!-- ═══ WHAT YOU LOG ═══ -->
<section class="cx-section cx-track" id="track">
  <div class="wrap cx-center">
    <p class="cx-kicker">What you log</p>
    <h2>What do I actually track?</h2>
    <p class="cx-lede cx-lede-center cx-track-lede">
      <span class="desk">Hover a card. Watch a small log become a health story.</span>
      <span class="mob">Tap a card to see a log become a pattern.</span>
    </p>
  </div>
  <ul class="cx-track-grid wrap" data-track-grid>
    {trackItems.map((item) => (
      <li class="cx-track-card" data-track={item.id}>
        <button type="button" class="cx-track-toggle" aria-expanded="false">
          <span class="cx-track-top">
            <span class="cx-track-label">{item.label}</span>
            <span class="cx-track-promise">{item.promise}</span>
          </span>

          <span class="cx-track-idle">
            <span class="cx-track-you">You log</span>
            <span class="cx-track-chips">
              {item.logs.map((log) => (
                <span>{log}</span>
              ))}
            </span>
            <span class="cx-track-hint">
              <span aria-hidden="true">↓</span> Sankalp notices
            </span>
          </span>

          <span class="cx-track-live" aria-hidden="true">
            <span class="cx-track-entry">
              <span class="cx-track-entry-title">{item.entryTitle}</span>
              <span class="cx-track-entry-detail">{item.entryDetail}</span>
            </span>
            <span class="cx-track-arrow" aria-hidden="true">↓</span>
            <span class="cx-track-pattern-block">
              <span class="cx-track-pattern-label">Pattern noticed</span>
              <span class="cx-track-pattern">{item.pattern}</span>
              <span class="cx-track-freq">{item.frequency}</span>
            </span>
          </span>
        </button>
      </li>
    ))}
  </ul>
</section>

<!-- ═══ TIMELINE → STORY ═══ -->
<section class="cx-section cx-timeline" id="moments" data-timeline>
  <div class="wrap cx-center">
    <p class="cx-kicker">Why it matters</p>
    <h2>Tiny moments become a story your doctor can read.</h2>
  </div>

  <div class="cx-timeline-stage wrap" aria-label="Animated timeline of days between doctor visits">
    <div class="cx-tl-ends">
      <span class="cx-tl-visit">Doctor visit</span>
      <span class="cx-tl-span">23 days</span>
      <span class="cx-tl-visit">Doctor visit</span>
    </div>
    <div class="cx-tl-line" aria-hidden="true"></div>
    <ul class="cx-tl-events">
      {timelineEvents.map((ev, i) => (
        <li class="cx-tl-event" style={`--i:${i}; --x:${(ev.day / 23) * 100}%`}>
          <span class="cx-tl-dot"></span>
          <span class="cx-tl-label">{ev.label}</span>
        </li>
      ))}
    </ul>
    <div class="cx-tl-collapse" aria-hidden="true">
      <div class="cx-tl-funnel">↓</div>
      <div class="cx-tl-story-card">
        <p class="cx-tl-story-kicker">Weekly story</p>
        <p class="cx-tl-story-text">Late dinners → poorer sleep → morning fatigue</p>
        <p class="cx-tl-story-end">Doctor understands.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ HEALTH STORY (BIG) ═══ -->
<section class="cx-section cx-week" id="health-story" data-week>
  <div class="wrap cx-center">
    <p class="cx-kicker">Health story</p>
    <h2>Your week, readable at a glance.</h2>
  </div>

  <div class="cx-week-board wrap" aria-label="Weekly health story building into a pattern">
    <ol class="cx-week-days">
      <li class="cx-week-day" style="--d:0">
        <span class="cx-week-dow">Monday</span>
        <ul>
          <li class="meal">Meal</li>
          <li class="move">Walk</li>
        </ul>
      </li>
      <li class="cx-week-day" style="--d:1">
        <span class="cx-week-dow">Tuesday</span>
        <ul>
          <li class="stress">Stress</li>
        </ul>
      </li>
      <li class="cx-week-day" style="--d:2">
        <span class="cx-week-dow">Wednesday</span>
        <ul>
          <li class="sleep">Poor sleep</li>
        </ul>
      </li>
      <li class="cx-week-day" style="--d:3">
        <span class="cx-week-dow">Thursday</span>
        <ul>
          <li class="meal late">Dinner 10:45 PM</li>
        </ul>
      </li>
      <li class="cx-week-day cx-week-day-pattern" style="--d:4">
        <span class="cx-week-dow">Friday</span>
        <div class="cx-week-pattern">
          <p class="cx-week-pattern-label">Pattern found</p>
          <p>Late dinners</p>
          <span aria-hidden="true">↓</span>
          <p>Poor sleep</p>
          <span aria-hidden="true">↓</span>
          <p>Morning fatigue</p>
        </div>
      </li>
    </ol>
  </div>
</section>

</div>

<!-- ═══ FIVE PILLARS ═══ -->
<section class="cx-section cx-pillars" id="pillars">
  <div class="wrap cx-center">
    <p class="cx-kicker">Five pillars</p>
    <h2>The everyday foundations Sankalp watches.</h2>
  </div>

  <div class="wrap">
    <div class="cx-pillar-list" role="tablist" aria-label="Five pillars">
      {pillars.map((p, i) => (
        <div class:list={['cx-pillar-item', { open: i === 0 }]} data-pillar-item={p.id}>
          <button
            type="button"
            class:list={['cx-pillar-trigger', { active: i === 0 }]}
            role="tab"
            id={`tab-${p.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${p.id}`}
            data-pillar={p.id}
          >
            <span>{p.label}</span>
            <span class="cx-pillar-plus" aria-hidden="true"></span>
          </button>
          <div
            class:list={['cx-pillar-body', { active: i === 0 }]}
            role="tabpanel"
            id={`panel-${p.id}`}
            aria-labelledby={`tab-${p.id}`}
            hidden={i !== 0}
            data-panel={p.id}
          >
            <div class="cx-pillar-mini">
              <div>
                <p class="cx-pillar-head">Why it matters</p>
                <p>{p.why}</p>
              </div>
              <div>
                <p class="cx-pillar-head">Common signs</p>
                <ul>
                  {p.signs.map((s) => <li>{s}</li>)}
                </ul>
              </div>
              <div>
                <p class="cx-pillar-head">What Sankalp notices</p>
                <p>{p.notices}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ DOCTOR CONVERSATION ═══ -->
<section class="cx-section cx-doctor" id="doctor">
  <div class="wrap cx-center">
    <p class="cx-kicker">With your doctor</p>
    <h2>Same appointment. Different conversation.</h2>
  </div>

  <div class="cx-doctor-split wrap reveal">
    <article class="cx-consult cx-consult-before">
      <p class="cx-consult-label">Before Sankalp</p>
      <div class="cx-chat">
        <p class="cx-chat-doc"><span>Doctor</span> How have you been?</p>
        <p class="cx-chat-you"><span>You</span> I don’t remember…</p>
      </div>
    </article>
    <article class="cx-consult cx-consult-after">
      <p class="cx-consult-label">With Sankalp</p>
      <div class="cx-chat">
        <p class="cx-chat-doc"><span>Doctor</span> I noticed your sleep changed after dinner got later.</p>
        <p class="cx-chat-you"><span>You</span> Yes. That’s exactly when it started.</p>
      </div>
    </article>
  </div>
</section>

<!-- ═══ PRIVACY ═══ -->
<section class="cx-section cx-privacy" id="privacy">
  <div class="wrap">
    <div class="cx-privacy-panel reveal">
      <p class="cx-kicker">Privacy</p>
      <h2>Your data belongs to you.</h2>
      <ul class="cx-privacy-points">
        <li>You decide when to share</li>
        <li>Encrypted in transit and at rest</li>
        <li>Export anytime</li>
      </ul>
    </div>
  </div>
</section>

<!-- ═══ TRUST ═══ -->
<section class="cx-section cx-trust" id="trust">
  <div class="wrap cx-center">
    <p class="cx-kicker">Designed with doctors</p>
    <h2>Built to sit beside clinical care, not replace it.</h2>
  </div>
  <ul class="cx-trust-roles wrap reveal">
    <li>General physicians</li>
    <li>Endocrinologists</li>
    <li>Lifestyle medicine</li>
    <li>Nutritionists</li>
  </ul>
  <figure class="cx-quote wrap reveal">
    <blockquote>
      “Patients forget the weeks between visits. A readable health story changes the consult.”
    </blockquote>
    <figcaption>Clinical collaborator feedback during early design</figcaption>
  </figure>
</section>

<!-- ═══ CLOSE ═══ -->
<section class="cx-section cx-close" id="start">
  <div class="wrap">
    <div class="cx-close-panel reveal">
      <p class="cx-close-kicker">Beyond symptoms</p>
      <h2>Understand your health beyond symptoms.</h2>
      <p class="cx-close-lede">
        Sankalp helps you capture everyday health so you and your doctor start every conversation with better context.
      </p>
      <div class="cx-cta cx-cta-center">
        <a href={appHref} target="_blank" rel="noopener" class="btn cx-btn-invert" data-cta="close-start">Start free</a>
        <a href={waHref} target="_blank" rel="noopener" class="cx-link cx-link-light" data-cta="whatsapp">Or join the community</a>
      </div>
    </div>
  </div>
</section>

</PageLayout>

<style>
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
  .cx-narrow { max-width: 640px; }
  .cx-center { text-align: center; max-width: 720px; margin-left: auto; margin-right: auto; }
  .cx-kicker {
    font-size: 12px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--gold); margin: 0 0 14px;
  }
  .cx-lede {
    font-size: 17px; color: var(--muted); line-height: 1.65; margin: 0;
    max-width: 46ch;
  }
  .cx-lede-left { max-width: 52ch; }
  .cx-lede-center { max-width: 58ch; margin-left: auto; margin-right: auto; }
  .cx-section { padding: clamp(72px, 10vw, 112px) 0; }
  .cx-section h2 {
    font-family: 'Fraunces', serif; font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -.3px; line-height: 1.2; margin: 0 0 16px; color: var(--ink);
  }
  .cx-link {
    color: var(--muted); font-size: 15px; font-weight: 500; text-decoration: none;
    transition: color .2s;
  }
  .cx-link:hover { color: var(--green); }
  .cx-link-light { color: rgba(255,253,249,.88); border-bottom: 1px solid rgba(217,184,119,.4); padding-bottom: 2px; }
  .cx-link-light:hover { color: #fff; border-bottom-color: #d9b877; }
  .cx-cta { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 28px; }
  .cx-cta-center { justify-content: center; }

  /* Shared hero + bridge field */
  .cx-topband {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 45% at 8% 12%, rgba(21,122,91,.07), transparent 58%),
      radial-gradient(ellipse 55% 40% at 92% 18%, rgba(194,149,78,.1), transparent 55%),
      radial-gradient(ellipse 45% 30% at 55% 55%, rgba(62,143,191,.05), transparent 60%),
      linear-gradient(180deg, #f3efe6 0%, #f6f4ef 42%, #eef5f1 78%, #eef5f1 100%);
  }
  .cx-topband > .cx-hero-field {
    position: absolute; inset: 0; pointer-events: none; z-index: 0;
  }

  /* Shared mid field: track → timeline → week */
  .cx-midband {
    position: relative;
    background:
      radial-gradient(ellipse 60% 28% at 50% 8%, rgba(21,122,91,.05), transparent 55%),
      radial-gradient(ellipse 50% 30% at 85% 55%, rgba(194,149,78,.06), transparent 50%),
      linear-gradient(180deg, #eef5f1 0%, var(--bg) 18%, var(--bg) 55%, #f3f7f4 78%, var(--bg) 100%);
  }
  .cx-midband > .cx-section {
    background: transparent;
  }

  /* Hero */
  .cx-hero {
    position: relative;
    z-index: 1;
    padding: 108px 0 56px;
    background: transparent;
  }
  .cx-orb {
    position: absolute; border-radius: 50%; filter: blur(48px);
    animation: orbDrift 14s ease-in-out infinite alternate;
  }
  .cx-orb-a {
    width: 42vw; height: 42vw; max-width: 520px; max-height: 520px;
    left: -8%; top: -6%; background: rgba(21,122,91,.08);
  }
  .cx-orb-b {
    width: 40vw; height: 40vw; max-width: 480px; max-height: 480px;
    right: -6%; top: 4%; background: rgba(194,149,78,.12); animation-delay: -4s;
  }
  .cx-orb-c {
    width: 28vw; height: 28vw; max-width: 320px; max-height: 320px;
    left: 42%; bottom: 4%; background: rgba(62,143,191,.07); animation-delay: -7s;
  }
  @keyframes orbDrift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(3%, 4%) scale(1.08); }
  }
  .cx-hero-grid {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  .cx-hero-copy { display: flex; flex-direction: column; align-items: flex-start; }
  .cx-hero .cx-kicker { margin-bottom: 12px; }
  .cx-hero h1 {
    font-family: 'Fraunces', serif; font-size: clamp(34px, 4.8vw, 52px);
    letter-spacing: -.55px; line-height: 1.05; margin: 0 0 14px; color: var(--ink);
    font-weight: 600;
  }
  .cx-hero .cx-lede {
    text-align: left; max-width: 28ch; font-size: 17px; line-height: 1.45;
    margin-bottom: 0;
  }
  .cx-hero .cx-cta { justify-content: flex-start; margin-top: 22px; }

  /* Living story card */
  .cx-hero-viz {
    min-width: 0;
    display: flex;
    justify-content: flex-end;
  }
  .cx-story {
    width: 100%;
    max-width: 520px;
    padding: 22px 22px 20px;
    border-radius: 22px;
    background:
      linear-gradient(165deg, rgba(255,253,249,.88) 0%, rgba(255,253,249,.72) 100%);
    border: 1px solid rgba(255,255,255,.7);
    box-shadow:
      0 1px 0 rgba(255,255,255,.8) inset,
      0 18px 50px rgba(14,92,68,.12),
      0 4px 14px rgba(24,36,32,.06);
    backdrop-filter: blur(18px) saturate(1.15);
    -webkit-backdrop-filter: blur(18px) saturate(1.15);
    animation: storyIn .6s var(--ease) both;
  }
  @keyframes storyIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  .cx-story-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 12px; margin-bottom: 22px;
  }
  .cx-story-kicker {
    margin: 0 0 4px;
    font-size: 11px; font-weight: 600; letter-spacing: 1.3px; text-transform: uppercase;
    color: var(--gold);
  }
  .cx-story-title {
    margin: 0;
    font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600;
    color: var(--ink); letter-spacing: -.2px;
  }
  .cx-story-range {
    margin: 4px 0 0;
    font-size: 12px; font-weight: 500; color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .cx-story-days {
    list-style: none; margin: 0; padding: 14px 8px 10px;
    display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;
    border-radius: 14px;
    background: rgba(246,244,239,.7);
    border: 1px solid rgba(221,214,203,.55);
  }
  .cx-story-day {
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    min-height: 88px; padding: 4px 0 6px;
    border-radius: 10px;
    opacity: 0;
    transform: translateY(8px);
    animation: dayIn .45s var(--ease) both;
    animation-delay: calc(0.18s + var(--d) * 0.28s);
  }
  @keyframes dayIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .cx-story-day:nth-child(4) {
    background: rgba(194,149,78,.1);
  }
  .cx-story-dow {
    font-size: 11px; font-weight: 600; letter-spacing: .04em;
    color: var(--muted); text-transform: uppercase;
  }
  .cx-mark {
    width: 9px; height: 9px; border-radius: 50%;
    opacity: 0; transform: scale(.4);
    animation: markPop .35s var(--ease) both;
  }
  .cx-story-day .cx-mark:nth-child(2) { animation-delay: calc(0.28s + var(--d) * 0.28s); }
  .cx-story-day .cx-mark:nth-child(3) { animation-delay: calc(0.38s + var(--d) * 0.28s); }
  .cx-story-day .cx-mark:nth-child(4) { animation-delay: calc(0.48s + var(--d) * 0.28s); }
  @keyframes markPop {
    from { opacity: 0; transform: scale(.4); }
    to { opacity: 1; transform: scale(1); }
  }
  .cx-mark.meal { background: #3a9e73; box-shadow: 0 0 0 3px rgba(58,158,115,.16); }
  .cx-mark.meal.late { background: #c2954e; box-shadow: 0 0 0 3px rgba(194,149,78,.18); }
  .cx-mark.sleep { background: #3e8fbf; box-shadow: 0 0 0 3px rgba(62,143,191,.16); }
  .cx-mark.sleep.late { background: #db7b4c; box-shadow: 0 0 0 3px rgba(219,123,76,.18); }
  .cx-mark.move { background: #4e9e68; box-shadow: 0 0 0 3px rgba(78,158,104,.16); }
  .cx-mark.stress { background: #d9b877; box-shadow: 0 0 0 3px rgba(217,184,119,.2); }
  .cx-mark.stress.hot { background: #d4917a; box-shadow: 0 0 0 3px rgba(212,145,122,.22); }

  .cx-story-legend {
    display: flex; flex-wrap: wrap; gap: 10px 14px;
    margin: 12px 2px 0;
    font-size: 11px; color: var(--muted); letter-spacing: .02em;
  }
  .cx-story-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .cx-story-legend i {
    width: 7px; height: 7px; border-radius: 50%; display: block;
  }
  .cx-story-legend i.meal { background: #3a9e73; }
  .cx-story-legend i.sleep { background: #3e8fbf; }
  .cx-story-legend i.move { background: #4e9e68; }
  .cx-story-legend i.stress { background: #d4917a; }

  .cx-story-insight {
    margin-top: 18px;
    padding: 14px 14px 13px;
    border-radius: 14px;
    background: rgba(14,92,68,.06);
    border: 1px solid rgba(21,122,91,.12);
    opacity: 0;
    transform: translateY(10px);
    animation: insightIn .5s var(--ease) both;
    animation-delay: 2.4s;
  }
  @keyframes insightIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  .cx-story-insight-label {
    margin: 0 0 6px;
    font-size: 10.5px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase;
    color: var(--green-dark);
  }
  .cx-story-insight-text {
    margin: 0;
    font-family: 'Fraunces', serif; font-size: 15.5px; font-style: italic;
    color: var(--ink); line-height: 1.4;
  }

  .cx-story-chip {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 14px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(230,243,237,.9);
    border: 1px solid rgba(21,122,91,.14);
    font-size: 12.5px; font-weight: 600; color: var(--green-dark);
    opacity: 0;
    transform: translateY(6px);
    animation: chipIn .45s var(--ease) both;
    animation-delay: 2.85s;
  }
  @keyframes chipIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .cx-story-chip-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px rgba(21,122,91,.15);
  }

  /* Bridge / capsule cycle */
  .cx-bridge {
    position: relative;
    z-index: 1;
    padding-top: clamp(24px, 4vw, 40px);
    padding-bottom: clamp(40px, 6vw, 64px);
    background: transparent;
  }
  .cx-cycle {
    max-width: 920px;
    margin: 44px auto 0;
  }
  .cx-cycle-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .cx-cycle-node {
    opacity: 0;
    transform: translateY(10px);
  }
  .cx-cycle.in .cx-cycle-node {
    animation: fadeUp .45s var(--ease) both;
    animation-delay: calc(var(--i) * 0.08s);
  }
  .cx-capsule {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 118px;
    padding: 14px 28px;
    border-radius: 999px;
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
    background: rgba(255,253,249,.92);
    border: 1px solid rgba(221,214,203,.85);
    box-shadow: 0 8px 24px rgba(24,36,32,.06);
  }
  .cx-capsule-core {
    min-width: 140px;
    color: #fffdf9;
    background: linear-gradient(145deg, #0e5c44, #157a5b);
    border-color: transparent;
    box-shadow: 0 10px 28px rgba(14,92,68,.22);
  }
  .cx-cycle-arrow {
    width: 42px;
    height: 2px;
    position: relative;
    background: rgba(21,122,91,.18);
    opacity: 0;
  }
  .cx-cycle.in .cx-cycle-arrow {
    animation: fadeUp .4s var(--ease) both;
    animation-delay: calc(var(--i) * 0.08s);
  }
  .cx-cycle-arrow span {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(21,122,91,.2), var(--green));
  }
  .cx-cycle-arrow span::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--green);
    border-top: 1.5px solid var(--green);
    transform: translateY(-50%) rotate(45deg);
  }
  .cx-cycle-return {
    margin: 14px auto 0;
    max-width: 520px;
    height: 52px;
    position: relative;
    color: rgba(21,122,91,.45);
    opacity: 0;
  }
  .cx-cycle.in .cx-cycle-return {
    animation: fadeUp .45s var(--ease) both;
    animation-delay: .45s;
  }
  .cx-cycle-return-svg {
    display: block;
    width: 100%;
    height: 48px;
  }
  .cx-cycle-return-path,
  .cx-cycle-return-head {
    fill: none;
  }
  .cx-cycle-return-label {
    position: absolute;
    left: 50%;
    bottom: 2px;
    transform: translateX(-50%);
    padding: 0 12px;
    background: #f6f4ef;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .cx-cycle-detail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .cx-cycle-panel {
    padding: 28px 24px 8px 0;
    opacity: 0;
    transform: translateY(12px);
  }
  .cx-cycle-panel + .cx-cycle-panel {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  .cx-cycle.in .cx-cycle-panel {
    animation: fadeUp .45s var(--ease) both;
    animation-delay: calc(0.55s + var(--i) * 0.1s);
  }
  .cx-journey-label {
    margin: 0 0 6px;
    font-size: 11px; font-weight: 600; letter-spacing: 1.4px; text-transform: uppercase;
    color: var(--gold);
  }
  .cx-cycle-panel-core .cx-journey-label { color: var(--green); }
  .cx-journey-sub {
    margin: 0 0 16px;
    font-family: 'Fraunces', serif; font-size: clamp(20px, 2.2vw, 24px); font-weight: 600;
    color: var(--ink); letter-spacing: -.2px; line-height: 1.15;
  }
  .cx-journey-chips {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .cx-journey-chips li {
    font-size: 12.5px; font-weight: 500; color: var(--green-dark);
    padding: 7px 12px; border-radius: 999px;
    background: rgba(230,243,237,.9);
    border: 1px solid rgba(21,122,91,.14);
  }
  .cx-journey-actions {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .cx-journey-actions li {
    font-size: 14.5px; color: var(--muted); line-height: 1.4;
    padding-left: 14px; position: relative;
  }
  .cx-journey-actions li::before {
    content: '';
    position: absolute; left: 0; top: .55em;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--green);
  }
  .cx-journey-actions strong { color: var(--ink); font-weight: 600; }
  .cx-journey-quote {
    margin: 0;
    font-family: 'Fraunces', serif; font-style: italic;
    font-size: 16.5px; color: var(--ink); line-height: 1.4;
  }

  .cx-bridge-end {
    text-align: center;
    margin: 40px auto 0;
    max-width: 36ch;
    font-family: 'Fraunces', serif;
    font-size: clamp(16px, 2vw, 18px);
    font-style: italic;
    color: var(--muted);
    line-height: 1.4;
    opacity: 0;
  }
  .cx-bridge-end.in {
    animation: fadeUp .4s var(--ease) both;
    animation-delay: .2s;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: none; }
  }

  .cx-track-lede .mob { display: none; }
  .cx-track-lede .desk { display: inline; }

  /* Track */
  .cx-track {
    padding-top: clamp(48px, 7vw, 72px);
    padding-bottom: clamp(48px, 7vw, 72px);
  }
  .cx-track-grid {
    list-style: none;
    margin: 40px auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    max-width: 980px;
    align-items: start;
  }
  .cx-track-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--bg-card);
    transition:
      opacity .3s var(--ease),
      transform .3s var(--ease),
      border-color .25s,
      box-shadow .3s var(--ease),
      background .25s;
  }
  .cx-track-grid.is-focusing .cx-track-card,
  .cx-track-grid:hover .cx-track-card {
    opacity: .42;
    transform: scale(.985);
  }
  .cx-track-grid.is-focusing .cx-track-card.is-open,
  .cx-track-grid:hover .cx-track-card:hover {
    opacity: 1;
    transform: translateY(-4px) scale(1);
    border-color: rgba(21,122,91,.32);
    background: #fff;
    box-shadow: 0 16px 36px rgba(24,36,32,.1);
    z-index: 2;
  }
  .cx-track-toggle {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    padding: 18px 16px 16px;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
  }
  .cx-track-top {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cx-track-label {
    font-family: 'Fraunces', serif;
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -.2px;
  }
  .cx-track-promise {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.4;
  }
  .cx-track-idle {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cx-track-you {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cx-track-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cx-track-chips span {
    padding: 5px 9px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--bg-soft);
    font-size: 12px;
    color: var(--ink);
  }
  .cx-track-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--green);
    font-weight: 500;
  }
  .cx-track-live {
    display: none;
    flex-direction: column;
    gap: 10px;
    padding-top: 2px;
    border-top: 1px solid rgba(21,122,91,.14);
  }
  .cx-track-card:hover .cx-track-idle,
  .cx-track-card.is-open .cx-track-idle,
  .cx-track-card:focus-within .cx-track-idle {
    display: none;
  }
  .cx-track-card:hover .cx-track-live,
  .cx-track-card.is-open .cx-track-live,
  .cx-track-card:focus-within .cx-track-live {
    display: flex;
  }
  .cx-track-entry-title {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
  }
  .cx-track-entry-detail {
    display: block;
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.4;
  }
  .cx-track-arrow {
    color: var(--green);
    font-size: 14px;
    line-height: 1;
  }
  .cx-track-pattern-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 12px 11px;
    border-radius: 12px;
    background: rgba(230,243,237,.75);
    border: 1px solid rgba(21,122,91,.14);
  }
  .cx-track-pattern-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cx-track-pattern {
    font-family: 'Fraunces', serif;
    font-size: 15px;
    color: var(--green-dark);
    line-height: 1.35;
  }
  .cx-track-freq {
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (hover: none) {
    .cx-track-grid:hover .cx-track-card {
      opacity: 1;
      transform: none;
    }
    .cx-track-grid:hover .cx-track-card:hover {
      box-shadow: none;
      border-color: var(--line);
      transform: none;
    }
    .cx-track-card:hover .cx-track-idle { display: flex; }
    .cx-track-card:hover .cx-track-live { display: none; }
    .cx-track-card.is-open .cx-track-idle { display: none; }
    .cx-track-card.is-open .cx-track-live { display: flex; }
  }

  /* Timeline */
  .cx-timeline {
    padding-top: clamp(40px, 6vw, 64px);
    padding-bottom: clamp(28px, 4vw, 40px);
  }
  .cx-timeline-stage {
    position: relative;
    margin-top: 48px;
    max-width: 920px;
    padding: 28px 8px 8px;
  }
  .cx-tl-ends {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 28px;
  }
  .cx-tl-visit {
    font-family: 'Fraunces', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .cx-tl-span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cx-tl-line {
    height: 2px;
    background: linear-gradient(90deg, var(--green), rgba(21,122,91,.2), var(--green));
    border-radius: 2px;
    transform-origin: left center;
    transform: scaleX(0);
  }
  .cx-timeline.in .cx-tl-line {
    animation: tlLine 1s var(--ease) .15s forwards;
  }
  @keyframes tlLine {
    to { transform: scaleX(1); }
  }
  .cx-tl-events {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    height: 110px;
  }
  .cx-tl-event {
    position: absolute;
    left: var(--x);
    top: 0;
    transform: translateX(-50%);
    text-align: center;
    opacity: 0;
  }
  .cx-timeline.in .cx-tl-event {
    animation: tlEvent .45s var(--ease) forwards;
    animation-delay: calc(.55s + var(--i) * .18s);
  }
  @keyframes tlEvent {
    from { opacity: 0; transform: translateX(-50%) translateY(10px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
  }
  .cx-tl-dot {
    display: block;
    width: 10px;
    height: 10px;
    margin: 14px auto 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px rgba(21,122,91,.12);
  }
  .cx-tl-label {
    display: block;
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
  }
  .cx-tl-collapse {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 0;
    opacity: 0;
    transform: translateY(12px);
  }
  .cx-timeline.in .cx-tl-collapse {
    animation: fadeUp .5s var(--ease) forwards;
    animation-delay: 2.1s;
  }
  .cx-tl-funnel {
    color: var(--green);
    font-size: 18px;
    margin-bottom: 10px;
  }
  .cx-tl-story-card {
    text-align: center;
    padding: 22px 28px;
    border-radius: 18px;
    border: 1px solid rgba(21,122,91,.2);
    background: rgba(230,243,237,.75);
    max-width: 360px;
  }
  .cx-tl-story-kicker {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cx-tl-story-text {
    margin: 0 0 10px;
    font-family: 'Fraunces', serif;
    font-size: 18px;
    color: var(--ink);
    line-height: 1.35;
  }
  .cx-tl-story-end {
    margin: 0;
    font-size: 14px;
    color: var(--green-dark);
    font-weight: 600;
  }
  .cx-timeline.in .cx-tl-events {
    animation: tlShrink .7s var(--ease) forwards;
    animation-delay: 1.9s;
  }
  @keyframes tlShrink {
    to { opacity: .35; transform: scale(.96); }
  }

  /* Big week board — continues from weekly story card */
  .cx-week {
    padding-top: clamp(20px, 3vw, 32px);
    padding-bottom: clamp(64px, 9vw, 96px);
  }
  .cx-week::before {
    content: '';
    display: block;
    width: 1.5px;
    height: 28px;
    margin: 0 auto 28px;
    border-radius: 2px;
    background: linear-gradient(180deg, rgba(21,122,91,.45), rgba(21,122,91,.08));
  }
  .cx-week-board {
    margin-top: 36px;
    max-width: 1000px;
  }
  .cx-week-days {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  .cx-week-day {
    min-height: 220px;
    padding: 18px 14px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    opacity: 0;
    transform: translateY(14px);
  }
  .cx-week.in .cx-week-day {
    animation: fadeUp .5s var(--ease) forwards;
    animation-delay: calc(.12s + var(--d) * .28s);
  }
  .cx-week-dow {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .cx-week-day ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cx-week-day li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--ink);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    opacity: 0;
  }
  .cx-week.in .cx-week-day li {
    animation: fadeUp .4s var(--ease) forwards;
    animation-delay: calc(.35s + var(--d) * .28s);
  }
  .cx-week-day li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
  }
  .cx-week-day li.sleep::before { background: #3e8fbf; }
  .cx-week-day li.stress::before { background: #c2954e; }
  .cx-week-day li.move::before { background: #2f9e6e; }
  .cx-week-day li.late {
    border-color: rgba(194,149,78,.35);
    background: rgba(194,149,78,.1);
  }
  .cx-week-day-pattern {
    background: linear-gradient(165deg, rgba(230,243,237,.95), var(--bg-card));
    border-color: rgba(21,122,91,.25);
  }
  .cx-week-pattern {
    opacity: 0;
  }
  .cx-week.in .cx-week-pattern {
    animation: fadeUp .55s var(--ease) forwards;
    animation-delay: 1.6s;
  }
  .cx-week-pattern-label {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cx-week-pattern p {
    margin: 0;
    font-family: 'Fraunces', serif;
    font-size: 16px;
    color: var(--ink);
    line-height: 1.3;
  }
  .cx-week-pattern span {
    display: block;
    margin: 6px 0;
    color: var(--green);
    font-size: 14px;
  }

  /* Pillars compact */
  .cx-pillars {
    background: var(--bg);
  }
  .cx-pillar-list {
    margin-top: 40px;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
    border-top: 1px solid var(--line);
  }
  .cx-pillar-item {
    border-bottom: 1px solid var(--line);
  }
  .cx-pillar-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-align: left;
    color: var(--ink);
    font-family: 'Fraunces', serif;
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 600;
  }
  .cx-pillar-trigger.active { color: var(--green-dark); }
  .cx-pillar-plus {
    width: 18px;
    height: 18px;
    position: relative;
    flex-shrink: 0;
  }
  .cx-pillar-plus::before,
  .cx-pillar-plus::after {
    content: '';
    position: absolute;
    background: currentColor;
    border-radius: 1px;
    transition: transform .2s;
  }
  .cx-pillar-plus::before {
    left: 0; right: 0; top: 50%; height: 1.5px; transform: translateY(-50%);
  }
  .cx-pillar-plus::after {
    top: 0; bottom: 0; left: 50%; width: 1.5px; transform: translateX(-50%);
  }
  .cx-pillar-trigger.active .cx-pillar-plus::after {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }
  .cx-pillar-body {
    padding: 0 4px 22px;
    animation: panelIn .3s var(--ease);
  }
  @keyframes panelIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .cx-pillar-mini {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.1fr;
    gap: 22px;
  }
  .cx-pillar-head {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 10px;
  }
  .cx-pillar-mini p {
    margin: 0;
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.5;
  }
  .cx-pillar-mini ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cx-pillar-mini li {
    position: relative;
    padding: 0 0 8px 12px;
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.4;
  }
  .cx-pillar-mini li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent, #c2954e);
  }

  /* Doctor split */
  .cx-doctor {
    background:
      radial-gradient(ellipse 50% 40% at 80% 10%, rgba(21,122,91,.07), transparent 50%),
      var(--bg-soft);
  }
  .cx-doctor-split {
    margin-top: 44px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 960px;
  }
  .cx-consult {
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    padding: 24px 22px 26px;
  }
  .cx-consult-after {
    border-color: rgba(21,122,91,.28);
    background: linear-gradient(165deg, rgba(230,243,237,.85), var(--bg-card));
  }
  .cx-consult-label {
    margin: 0 0 18px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cx-consult-after .cx-consult-label { color: var(--green); }
  .cx-chat {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cx-chat p {
    margin: 0;
    padding: 14px 16px;
    border-radius: 14px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink);
  }
  .cx-chat span {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .8px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .cx-chat-doc {
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }
  .cx-chat-you {
    background: rgba(230,243,237,.65);
    border: 1px solid rgba(21,122,91,.16);
  }
  .cx-consult-before .cx-chat-you {
    background: rgba(212,145,122,.1);
    border-color: rgba(212,145,122,.2);
    color: var(--muted);
    font-style: italic;
  }

  /* Privacy */
  .cx-privacy { background: var(--bg); }
  .cx-privacy-panel {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: 36px 28px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--bg-card);
  }
  .cx-privacy-panel h2 {
    max-width: 16ch;
    margin-left: auto;
    margin-right: auto;
  }
  .cx-privacy-points {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 18px;
  }
  .cx-privacy-points li {
    font-size: 14.5px;
    color: var(--muted);
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-soft);
  }

  /* Trust */
  .cx-trust { background: var(--bg); padding-top: 40px; }
  .cx-trust-roles {
    list-style: none;
    margin: 36px auto 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 820px;
  }
  .cx-trust-roles li {
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    font-size: 14px;
    color: var(--ink);
  }
  .cx-quote {
    margin: 40px auto 0;
    max-width: 560px;
    text-align: center;
  }
  .cx-quote blockquote {
    margin: 0;
    font-family: 'Fraunces', serif;
    font-size: clamp(20px, 2.6vw, 26px);
    font-style: italic;
    color: var(--ink);
    line-height: 1.35;
  }
  .cx-quote figcaption {
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted);
  }

  /* Close */
  .cx-close { padding-bottom: clamp(80px, 11vw, 120px); }
  .cx-close-panel {
    position: relative; overflow: hidden;
    max-width: 760px; margin: 0 auto; border-radius: 28px;
    padding: clamp(48px, 7vw, 72px) clamp(28px, 5vw, 48px);
    text-align: center;
    background: linear-gradient(145deg, #0e5c44 0%, #157a5b 50%, #1a6e54 100%);
    color: #fffdf9;
    box-shadow: 0 1px 0 rgba(255,255,255,.1) inset, 0 28px 60px rgba(14,92,68,.28);
  }
  .cx-close-panel::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 60% 50% at 15% 0%, rgba(194,149,78,.2), transparent 55%);
  }
  .cx-close-kicker {
    position: relative; font-size: 12px; font-weight: 600; letter-spacing: 1.6px;
    text-transform: uppercase; color: #d9b877; margin: 0 0 14px;
  }
  .cx-close-panel h2 {
    position: relative; color: #fffdf9; font-size: clamp(28px, 4vw, 40px);
    max-width: 14ch; margin: 0 auto 16px;
  }
  .cx-close-lede {
    position: relative; color: rgba(255,253,249,.88); max-width: 44ch; margin: 0 auto;
    font-size: 16.5px; line-height: 1.55;
  }
  .cx-close-panel .cx-cta { position: relative; margin-top: 32px; }
  .cx-btn-invert {
    display: inline-flex; align-items: center; justify-content: center;
    background: #fffdf9; color: #0e5c44; font-weight: 600; font-size: 15.5px;
    padding: 15px 30px; border-radius: 100px; text-decoration: none; border: none;
    box-shadow: 0 8px 24px rgba(0,0,0,.18); transition: transform .2s, background .2s;
  }
  .cx-btn-invert:hover { background: #f4ece2; color: #0e5c44; transform: translateY(-2px); }

  .reveal { opacity: 0; transform: translateY(14px); transition: opacity .55s var(--ease), transform .55s var(--ease); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .cx-orb, .cx-story,
    .cx-story-day, .cx-mark, .cx-story-insight, .cx-story-chip,
    .cx-cycle-node, .cx-cycle-arrow, .cx-cycle-return, .cx-cycle-panel, .cx-bridge-end,
    .cx-tl-line, .cx-tl-event, .cx-tl-collapse, .cx-tl-events,
    .cx-week-day, .cx-week-day li, .cx-week-pattern, .cx-pillar-body {
      animation: none !important;
    }
    .cx-story-day, .cx-mark, .cx-story-insight, .cx-story-chip,
    .cx-cycle-node, .cx-cycle-arrow, .cx-cycle-return, .cx-cycle-panel, .cx-bridge-end,
    .cx-tl-line, .cx-tl-event, .cx-tl-collapse, .cx-week-day, .cx-week-day li, .cx-week-pattern {
      opacity: 1; transform: none;
    }
    .cx-tl-events { opacity: 1; transform: none; }
  }

  @media (max-width: 900px) {
    .cx-section { padding: clamp(56px, 9vw, 88px) 0; }
    .cx-hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .cx-hero-viz { justify-content: stretch; }
    .cx-story { max-width: none; }
    .cx-track-grid { grid-template-columns: 1fr 1fr; }
    .cx-week-days {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 10px;
      padding-bottom: 6px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .cx-week-day {
      flex: 0 0 min(46%, 200px);
      min-height: 170px;
      scroll-snap-align: start;
    }
    .cx-week-day-pattern {
      flex-basis: min(70%, 280px);
      min-height: 170px;
    }
    .cx-pillar-mini { grid-template-columns: 1fr; gap: 16px; }
    .cx-doctor-split { grid-template-columns: 1fr; }
    .cx-tl-events {
      height: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      position: static;
      margin: 20px 0 8px;
    }
    .cx-tl-event {
      position: static;
      transform: none;
      text-align: center;
      padding: 12px 10px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: var(--bg-card);
    }
    .cx-timeline.in .cx-tl-event { animation: fadeUp .4s var(--ease) forwards; }
    .cx-tl-label { white-space: normal; font-size: 12.5px; color: var(--ink); }
    .cx-tl-dot { margin: 0 auto 8px; }
    .cx-timeline.in .cx-tl-events {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .cx-cycle-row { gap: 10px; }
    .cx-capsule { min-width: 96px; padding: 12px 20px; font-size: 18px; }
    .cx-capsule-core { min-width: 112px; }
    .cx-cycle-arrow { width: 28px; }
    .cx-cycle-detail {
      grid-template-columns: 1fr;
      margin-top: 32px;
    }
    .cx-cycle-panel {
      padding: 22px 0;
      border-top: 1px solid var(--line);
    }
    .cx-cycle-panel + .cx-cycle-panel {
      padding-left: 0;
      border-left: none;
    }
    .cx-cycle-return { max-width: 280px; }
  }

  @media (max-width: 640px) {
    .wrap { padding: 0 18px; }
    .cx-section { padding: 52px 0; }
    .cx-section h2 { font-size: clamp(24px, 7vw, 30px); margin-bottom: 12px; }
    .cx-lede { font-size: 15.5px; }
    .cx-kicker { margin-bottom: 10px; font-size: 11px; }

    .cx-hero { padding: 96px 0 28px; }
    .cx-hero h1 {
      font-size: clamp(30px, 8.5vw, 36px);
      margin-bottom: 12px;
    }
    .cx-hero .cx-lede { font-size: 15.5px; max-width: 32ch; }
    .cx-hero .cx-cta { margin-top: 18px; gap: 12px; }
    .cx-hero-grid { gap: 22px; }

    .cx-story { padding: 16px 14px 14px; border-radius: 18px; }
    .cx-story-top { margin-bottom: 14px; }
    .cx-story-title { font-size: 18px; }
    .cx-story-range { font-size: 11px; }
    .cx-story-days {
      grid-template-columns: repeat(5, 1fr);
      padding: 10px 4px 8px;
      gap: 2px;
      border-radius: 12px;
    }
    .cx-story-day {
      min-height: 64px;
      gap: 5px;
      padding: 2px 0 4px;
    }
    .cx-story-day:nth-child(n+6) { display: none; }
    .cx-story-dow { font-size: 10px; }
    .cx-mark { width: 7px; height: 7px; }
    .cx-mark.meal,
    .cx-mark.meal.late,
    .cx-mark.sleep,
    .cx-mark.sleep.late,
    .cx-mark.move,
    .cx-mark.stress,
    .cx-mark.stress.hot {
      box-shadow: 0 0 0 2px rgba(58,158,115,.14);
    }
    .cx-story-legend {
      gap: 8px 12px;
      margin-top: 10px;
      font-size: 10px;
    }
    .cx-story-insight {
      margin-top: 12px;
      padding: 12px 12px 11px;
    }
    .cx-story-insight-text {
      font-size: 13.5px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .cx-story-chip { margin-top: 10px; font-size: 12px; }

    .cx-bridge { padding-bottom: 40px; }
    .cx-cycle { margin-top: 28px; }
    .cx-cycle-row {
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: center;
      align-items: center;
      gap: 6px;
    }
    .cx-cycle-arrow {
      width: 18px;
      height: auto;
      transform: none;
      flex-shrink: 0;
    }
    .cx-capsule,
    .cx-capsule-core {
      min-width: 0;
      width: auto;
      max-width: none;
      padding: 10px 14px;
      font-size: 15px;
      text-align: center;
    }
    .cx-cycle-return { display: none; }
    .cx-cycle-detail {
      margin-top: 24px;
      gap: 0;
      text-align: center;
    }
    .cx-cycle-panel { padding: 16px 0; }
    .cx-journey-label,
    .cx-journey-sub { text-align: center; }
    .cx-journey-chips {
      gap: 6px;
      justify-content: center;
    }
    .cx-journey-chips li { padding: 5px 10px; font-size: 12.5px; }
    .cx-journey-actions {
      align-items: center;
      text-align: center;
    }
    .cx-journey-actions li {
      padding-left: 0;
    }
    .cx-journey-actions li::before { display: none; }
    .cx-journey-quote { text-align: center; }
    .cx-bridge-end {
      margin-top: 28px;
      font-size: 15px;
      text-align: center;
    }

    .cx-track-lede .desk { display: none; }
    .cx-track-lede .mob { display: inline; }
    .cx-track {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .cx-track-grid {
      margin-top: 28px;
      gap: 10px;
    }
    .cx-track-grid.is-focusing .cx-track-card,
    .cx-track-grid:hover .cx-track-card {
      opacity: 1;
      transform: none;
    }
    .cx-track-grid.is-focusing .cx-track-card.is-open,
    .cx-track-grid:hover .cx-track-card:hover {
      transform: none;
      box-shadow: 0 8px 22px rgba(24,36,32,.08);
    }
    .cx-track-toggle { padding: 14px 12px 12px; gap: 10px; }
    .cx-track-label { font-size: 16px; }
    .cx-track-promise { display: none; }
    .cx-track-chips span:nth-child(n+3) { display: none; }
    .cx-track-chips span { padding: 4px 7px; font-size: 11px; border-radius: 7px; }
    .cx-track-hint { font-size: 11.5px; }
    .cx-track-pattern { font-size: 13.5px; }
    .cx-track-entry-title { font-size: 13.5px; }
    .cx-track-entry-detail { font-size: 12.5px; }
    .cx-track-freq { font-size: 11.5px; }
    .cx-track-pattern-block { padding: 10px; }

    .cx-timeline {
      padding-top: 36px;
      padding-bottom: 20px;
    }
    .cx-timeline-stage {
      margin-top: 24px;
      padding: 0;
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
    }
    .cx-tl-ends {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      margin-bottom: 0;
      padding: 0 2px;
    }
    .cx-tl-visit {
      font-size: 13px;
      line-height: 1.25;
    }
    .cx-tl-ends .cx-tl-visit:first-child { text-align: left; }
    .cx-tl-ends .cx-tl-visit:last-child { text-align: right; }
    .cx-tl-span {
      font-size: 10px;
      letter-spacing: 1px;
      padding: 4px 8px;
      border-radius: 999px;
      background: var(--green-soft);
      color: var(--green-dark);
      white-space: nowrap;
    }
    .cx-tl-line {
      display: block;
      margin: 10px 0 18px;
      transform: scaleX(1);
      height: 1.5px;
      background: linear-gradient(90deg, var(--green), rgba(21,122,91,.18), var(--green));
    }
    .cx-timeline.in .cx-tl-line { animation: none; }
    .cx-tl-events {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin: 0 0 4px;
      height: auto;
      position: static;
    }
    .cx-tl-event {
      position: static;
      transform: none;
      display: flex;
      align-items: center;
      gap: 8px;
      justify-content: flex-start;
      text-align: left;
      padding: 10px 12px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: var(--bg-card);
      opacity: 1;
    }
    .cx-tl-event:nth-child(n+7) { display: none; }
    .cx-timeline.in .cx-tl-event {
      animation: fadeUp .4s var(--ease) forwards;
      animation-delay: calc(.1s + var(--i) * .08s);
    }
    .cx-tl-dot {
      display: block;
      width: 7px;
      height: 7px;
      margin: 0;
      flex-shrink: 0;
      box-shadow: 0 0 0 3px rgba(21,122,91,.12);
    }
    .cx-tl-label {
      display: block;
      margin: 0;
      font-size: 12.5px;
      color: var(--ink);
      line-height: 1.25;
      white-space: normal;
    }
    .cx-timeline.in .cx-tl-events {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .cx-tl-collapse { margin-top: 14px; }
    .cx-tl-funnel { margin-bottom: 8px; font-size: 16px; }
    .cx-tl-story-card {
      padding: 18px 16px;
