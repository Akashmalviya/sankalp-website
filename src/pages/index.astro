      border-radius: 16px;
    }
    .cx-tl-story-text { font-size: 16px; }

    .cx-week {
      padding-top: 16px;
      padding-bottom: 56px;
    }
    .cx-week::before { height: 20px; margin-bottom: 20px; }
    .cx-week-board { margin-top: 24px; }
    .cx-week-day {
      flex: 0 0 58%;
      min-height: 150px;
