---
interface Props {
  /** relative path prefix to the site root — "" at root, "../" one level down (e.g. blog/*) */
  base?: string;
}
const { base = '' } = Astro.props;
---
<footer>
  <div class="foot-inner">
    <a href={`${base}index.html`} class="brand" style="font-size:18px">
      <span class="mark" style="width:26px;height:26px">
        <svg class="lotus" viewBox="0 0 512 512" role="img" aria-label="Sankalp lotus">
          <g class="petals">
            <path class="p p1" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#3a9e73"/>
            <path class="p p2" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#3a9e73"/>
            <path class="p p3" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#1f7d5b"/>
            <path class="p p4" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#1f7d5b"/>
            <path class="p p5" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#0e5c44"/>
          </g>
          <circle class="seed" cx="256" cy="356" r="15" fill="#c2954e"/>
        </svg>
      </span>
      Sankalp
    </a>
    <div class="foot-links">
      <a href={`${base}index.html#pillars`}>The five pillars</a>
      <a href={`${base}index.html#how`}>How it works</a>
      <a href={`${base}blog/`}>Blog</a>
      <a href={`${base}for-doctors.html`}>For Doctors</a>
      <a href={`${base}privacy.html`}>Privacy</a>
      <a href="https://wa.me/918359011231?text=Hi%2C%20I%27d%20like%20to%20book%20a%20free%20discovery%20call%20with%20Sankalp." target="_blank" rel="noopener">Book a free call</a>
    </div>
    <p class="foot-copy">&copy; 2026 Sankalp &middot; sankalphealth.in</p>
  </div>
</footer>
