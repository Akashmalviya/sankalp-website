---
interface Props {
  /** relative path prefix to the site root — "" at root, "../" one level down (e.g. blog/*) */
  base?: string;
  /** which nav item to highlight as current */
  active?: 'app' | 'blog' | 'for-doctors' | 'for-coaches' | 'home' | 'your-coach';
}
const { base = '', active } = Astro.props;

const isHome = active === 'home' || active === 'for-coaches';
const isCoach = active === 'your-coach';
const ctaHref = active === 'for-doctors'
  ? 'mailto:hello@sankalphealth.in?subject=Healthcare%20professionals%20%C2%B7%20Sankalp'
  : 'https://app.sankalphealth.in/';
const ctaLabel = active === 'for-doctors' ? 'Talk to us' : 'Start free';
const ctaExternal = ctaHref.startsWith('http');
---
<nav class="site-nav" aria-label="Primary">
  <div class="nav-raft">
    <a href={`${base}index.html`} class="brand">
      <span class="mark" aria-hidden="true">
        <svg class="lotus" viewBox="0 0 512 512" role="img" aria-label="Sankalp lotus">
          <g class="petals">
            <path class="p p1" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#3a9e73"/>
            <path class="p p2" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#3a9e73"/>
            <path class="p p3" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#1f7d5b"/>
            <path class="p p4" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#1f7d5b"/>
            <path class="p p5" d="M256 130 A150 150 0 0 1 256 366 A150 150 0 0 1 256 130 Z" fill="#0e5c44"/>
          </g>
          <circle class="seed" cx="256" cy="356" r="15" fill="#c2954e"/>
        </svg>
      </span>
      Sankalp
    </a>
    <div class="nav-trail">
      <ul class="nav-links">
        <li>
          <a href={isHome ? '#story' : `${base}index.html#story`}>How it works</a>
        </li>
        <li>
          <a href={isHome ? '#health-story' : `${base}index.html#health-story`}>Health story</a>
        </li>
        <li>
          <a href={`${base}your-coach.html`} class={isCoach ? 'active' : undefined}>About</a>
        </li>
        <li>
          <a href={`${base}blog/`} class={active === 'blog' ? 'active' : undefined}>Blog</a>
        </li>
      </ul>
      <a
        href={ctaHref}
        class="nav-cta"
        {...(ctaExternal ? { target: '_blank', rel: 'noopener' } : {})}
      >{ctaLabel}</a>
      <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false">
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</nav>

<script>
  document.querySelectorAll('.nav-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const raft = btn.closest('.nav-raft') || btn.parentElement;
      const links = raft?.querySelector('.nav-links');
      if (!links) return;
      const open = links.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
  document.querySelectorAll('.nav-links a').forEach((a) => {
    a.addEventListener('click', () => {
      a.closest('.nav-links')?.classList.remove('open');
      document.querySelectorAll('.nav-toggle').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  });
</script>
